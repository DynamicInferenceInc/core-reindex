# Used only by docker compose for volume interpolation.
# These values are not injected into containers.
# Keep LOCAL_DOCS_CONTAINER equal to WATCH_PATH in local-reindex/.env
# and SMB_STAGING_CONTAINER equal to SMB_STAGING_PATH in smb-reindex/.env.

LOCAL_DOCS_HOST=./local-reindex/docs
LOCAL_DOCS_CONTAINER=/data/docs

SMB_STAGING_HOST=./smb-reindex/staging
SMB_STAGING_CONTAINER=/data/staging
