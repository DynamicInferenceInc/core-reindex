# Used only by docker compose for volume interpolation.
# These values are not injected into containers.
# Keep LOCAL_DOCS_CONTAINER equal to SOURCE__WATCH_PATH in local-reindex/.env
# and LOCAL_CV_CONTAINER equal to SOURCE__WATCH_PATH in local-reindex/.env.cv
# and SMB_STAGING_CONTAINER equal to SOURCE__STAGING_PATH in smb-reindex/.env.

LOCAL_DOCS_HOST=./local-reindex/docs
LOCAL_DOCS_CONTAINER=/data/docs

LOCAL_CV_HOST=./local-reindex/cv
LOCAL_CV_CONTAINER=/data/cv

SMB_STAGING_HOST=./smb-reindex/staging
SMB_STAGING_CONTAINER=/data/staging
